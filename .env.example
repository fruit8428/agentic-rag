# =============================================================================
# 本檔是範本：複製成 .env 後填值。.env 絕對不要進 git。
# 改完 .env 後執行「同步環境變數到Vercel.command」（或 bash scripts/sync_vercel_env.sh）寫進 Vercel。
# =============================================================================

# ===================== 每個地區都不同 =====================

# 地區代號與名稱：前端標題、AI 提示詞、新社帳號的合成 Email 網域（clubs.<代號>.local）都用它
DISTRICT_CODE=3523
DISTRICT_NAME=國際扶輪 3523 地區

# 這個地區的 Supabase（Project Settings -> API Keys）。anon 用 sb_publishable_，service role 用 sb_secret_
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 前端（瀏覽器）用的同一組 URL 與 anon key（Vite 只注入 VITE_ 開頭變數）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 地區管理員：登入用的 Email 與「忘記密碼」顯示的聯絡方式
ADMIN_EMAIL=
ADMIN_CONTACT=

# 各社社密碼紀錄的加密金鑰（任意長隨機字串；設定後不可更換，否則後台看不到舊密碼）
CLUB_PASSWORD_SECRET=
# 新社建立時統一使用的預設社密碼（執秘登入後應自行更改）
CLUB_DEFAULT_PASSWORD=123456

# 報名系統橋接（AI 小幫手回答「我們社報名了什麼、繳費了沒」）。全部選填，沒設定時 AI 會回「尚未連接報名系統」
# 只需要 anon（sb_publishable_）key，不要填 secret key；值在報名系統的 config/districts/<代號>.json
SIGNUP_SUPABASE_URL=
SIGNUP_SUPABASE_ANON_KEY=
SIGNUP_SITE_URL=                       # 報名系統網址（例如 https://3523d.vercel.app），AI 回答時會附上

# ===================== 所有地區共用 =====================

# Google AI Studio / Gemini（https://aistudio.google.com/apikey）。更換 LLM_MODEL 後請重測 RAG 問答；
# 更換 EMBEDDING_MODEL 會改變向量維度，必須重新上傳所有文件
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# LangSmith 可觀測性追蹤（https://smith.langchain.com/），選填
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag

# 報名系統內部儲存 key，所有地區相同，通常不用改
SIGNUP_STORAGE_KEY=rotary_3523_spa_data_v3
SIGNUP_PAYMENT_KEY=rotary_3523_payment_records_v1

# 聊天 API 速率限制：每社每分鐘最多幾次（預設 10；填 0 代表不限制）
CHAT_RATE_LIMIT_PER_MINUTE=10
