# ==========================================
# 1. Supabase 設定 (從 Supabase Project Settings -> API 取得)
# ==========================================
SUPABASE_URL=https://你的專案ID.supabase.co
SUPABASE_ANON_KEY=你的_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=你的_supabase_service_role_key

# ==========================================
# 2. Google AI Studio / Gemini 設定 (從 https://aistudio.google.com/apikey 取得)
# ==========================================
GEMINI_API_KEY=你的_google_ai_studio_api_key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# ==========================================
# 3. LangSmith 可觀測性追蹤設定 (從 https://smith.langchain.com/ 取得)
# ==========================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=你的_langsmith_api_key
LANGSMITH_PROJECT=agentic-rag

# ==========================================
# 4. 前端（瀏覽器）用的 Supabase 設定（與上方相同的 URL 與 anon key，Vite 只注入 VITE_ 開頭變數）
# ==========================================
VITE_SUPABASE_URL=https://你的專案ID.supabase.co
VITE_SUPABASE_ANON_KEY=你的_supabase_anon_public_key
