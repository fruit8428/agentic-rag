# ==========================================
# 1. Supabase 設定 (從 Supabase Project Settings -> API 取得)
# ==========================================
SUPABASE_URL=https://你的專案ID.supabase.co
SUPABASE_ANON_KEY=你的_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=你的_supabase_service_role_key

# ==========================================
# 2. Google AI Studio / Gemini 設定 (從 https://aistudio.google.com/apikey 取得)
# ==========================================
GEMINI_API_KEY=你的_google_ai_studio_api_key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# ==========================================
# 3. LangSmith 可觀測性追蹤設定 (從 https://smith.langchain.com/ 取得)
# ==========================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=你的_langsmith_api_key
LANGSMITH_PROJECT=agentic-rag

# ==========================================
# 4. 前端（瀏覽器）用的 Supabase 設定（與上方相同的 URL 與 anon key，Vite 只注入 VITE_ 開頭變數）
# ==========================================
VITE_SUPABASE_URL=https://你的專案ID.supabase.co
VITE_SUPABASE_ANON_KEY=你的_supabase_anon_public_key

# 模組 10：各社社密碼紀錄的加密金鑰（任意長隨機字串）
CLUB_PASSWORD_SECRET=

# =============================================================================
# 5. 報名系統橋接（AI 小幫手回答「我們社報名了什麼、繳費了沒」）。全部選填
#    沒設定時 AI 會回「本地區尚未連接報名系統」。只需要 anon（sb_publishable_）key，不要填 secret key
# =============================================================================
SIGNUP_SUPABASE_URL=                   # 報名系統的 Supabase 專案網址（報名系統 index.html 第 21 行）
SIGNUP_SUPABASE_ANON_KEY=              # 報名系統的 anon key（index.html 第 22 行，sb_publishable_ 開頭）
SIGNUP_STORAGE_KEY=rotary_3523_spa_data_v3            # 報名系統主資料 key，通常不用改
SIGNUP_PAYMENT_KEY=rotary_3523_payment_records_v1     # 報名系統繳費紀錄 key，通常不用改
SIGNUP_SITE_URL=                       # 報名系統網址（例如 https://3523d.vercel.app），AI 回答時會附上
